# ==============================================================================
# SISTEMA INTELIGENTE DE LEAD SCORING - PLURIONE (RELEASE v1.0.0)
# Plantilla de Variables de Entorno para Producción / Despliegue
# ==============================================================================

# Entorno y Depuración
ENVIRONMENT=development
DEBUG=False
APP_NAME="Sistema Inteligente de Lead Scoring - PluriOne"
API_V1_STR=/api/v1
# OBLIGATORIA en production/staging: el arranque aborta si falta o es débil (<32 caracteres).
# Genérela con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# --- Sesiones JWT ---
# Access token corto (solo en memoria del navegador) + refresh en cookie HttpOnly.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# La cookie de refresco exige HTTPS en production/staging. Póngala en false solo si
# sirve un despliegue de demostración sobre HTTP plano.
REFRESH_COOKIE_SECURE=true

# --- Webhook CRM (HMAC-SHA256) ---
# Secreto compartido con el CRM emisor. Si queda vacío, el endpoint responde 503
# en lugar de aceptar tráfico anónimo. Genérelo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_TOLERANCE_SECONDS=300

# --- Limitación de tasa por IP ---
# Se aplica a login, webhook CRM e inferencia de scoring: las tres rutas que se pueden
# abusar sin credenciales válidas o con un solo token. Póngala en false solo si el corte
# lo aplica un balanceador por delante.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_WEBHOOK=120/minute
# Donde se lleva la cuenta. Con `memory://` cada worker de uvicorn cuenta por su lado, asi
# que el tope real que percibe un cliente es el declarado MULTIPLICADO por el numero de
# workers (medido: con 2 workers y "10/minute" pasan 14 intentos antes del corte). Para un
# limite exacto, o para mas de una instancia, apunte a un almacen compartido:
#   RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# Solo con un proxy de confianza delante (el nginx de la pila). Expuesto directamente a
# internet debe ser false: cualquiera podría rotar X-Forwarded-For y esquivar el límite.
TRUST_PROXY_HEADERS=true

# --- Contraseñas de las cuentas sembradas por scripts/seed_data.py ---
# Sin estas variables, fuera de producción se usa una contraseña de desarrollo conocida;
# en producción se genera una aleatoria y se muestra UNA sola vez en la salida del script.
SEED_ADMIN_PASSWORD=
SEED_SALES_LEAD_PASSWORD=
SEED_EXECUTIVE_PASSWORD=

# Base de Datos (SQLite lista para producción local o PostgreSQL para clúster)
DATABASE_URL=sqlite:///./lead_scoring.db
# Para PostgreSQL en contenedor:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_scoring_db

POSTGRES_USER=plurione
# OBLIGATORIA en el despliegue con Docker: `docker compose` aborta si falta. Sin valor
# por defecto a propósito —"postgres/postgres" es la primera credencial que prueba
# cualquier escaneo—. Genérela con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=lead_scoring_db
# Solo se usa con el overlay de desarrollo, que publica el puerto en 127.0.0.1.
POSTGRES_PORT=5432

# --- Credenciales de pgAdmin (solo docker-compose.dev.yml) ---
# Sin valores por defecto: el overlay de desarrollo no arranca si faltan.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Modo de Inferencia: 'native' (Scikit-Learn GradientBoosting calibrado + XAI nativo)
AI_MODE=native
MODEL_VERSION=v1.0.0-hybrid
# Ruta absoluta del artefacto .joblib. Vacía, el adaptador lo busca en
# `ml_pipeline/models/` relativo al repositorio. La imagen Docker la fija a
# /opt/plurione/models/lead_scorer_model.joblib, donde copia el modelo entrenado.
ML_MODEL_PATH=
# Huella SHA-256 esperada del artefacto. `joblib` deserializa con pickle, que ejecuta
# codigo al cargar: quien pueda sustituir el fichero al que apunta ML_MODEL_PATH ejecuta lo
# que quiera dentro del backend. Con este valor fijado, una huella distinta impide la carga
# en lugar de ejecutarla; el sistema sigue en pie sobre el heuristico y lo registra.
# `train_model.py` la imprime al terminar y la deja en ml_pipeline/models/metrics.json.
ML_MODEL_SHA256=

# --- Azure AI Search (solo con AI_MODE=azure) ---
# Búsqueda semántica de prospectos convertidos similares. Con AI_MODE=native se ignoran.
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=plurione-leads-index

# Ponderaciones Algorítmicas
# DEBEN sumar exactamente 1.0: la fórmula solo produce una escala 0-100 en ese caso, y
# el arranque se aborta si no cuadran. Para recalibrar, mueva las dos de forma
# complementaria (p. ej. 0.75 / 0.25).
SCORE_WEIGHT_ML=0.60
SCORE_WEIGHT_HEURISTIC=0.40
DECAY_HALF_LIFE_DAYS=14.0
HOT_THRESHOLD=75.0
WARM_THRESHOLD=45.0

# CORS Origins Permitidos
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Publicaciones de LinkedIn: dirección pública bajo la que se sirve el enlace de cada una
# (`<base>/<slug>`). Es lo que se pega en LinkedIn: en un despliegue, la del sitio público.
PUBLICACIONES_URL_BASE=http://localhost:3000/interes

# Página de interés (pública). Límites de envío del formulario al que lleva el enlace de una
# publicación: por IP y por publicación. Son bajos a propósito.
INTERES_LIMITE_POR_IP=10/hour
INTERES_LIMITE_POR_PUBLICACION=120/hour
# Abrir la página tiene su propia cuenta: ver el formulario no gasta el cupo de enviarlo.
INTERES_LIMITE_DE_LECTURAS_POR_IP=120/hour

# Control de Acceso Basado en Roles (RBAC)
DEFAULT_TENANT_ID=plurione-enterprise-tenant
DEFAULT_USER_ROLE=Commercial_Executive
