# ==============================================================================
# VARIABLES DE LA PILA DE DESPLIEGUE (docker compose)
# ==============================================================================
# Es la PLANTILLA del archivo de entorno de la pila, que vive FUERA del repositorio
# (capítulo 22). No lo copie a mano: créelo, con los dos secretos obligatorios ya generados,
# con
#     python devops/pila.py iniciar
#
# que lo escribe en `~/.plurione/pila.env` (o donde indique PLURIONE_ENTORNO) con permisos
# solo para su usuario. Toda orden de la pila pasa por el mismo lanzador:
#     python devops/pila.py up -d --build
#
# El lanzador se niega a arrancar si encuentra un `.env` dentro del repositorio: Compose
# carga el de `devops/` sin que nadie se lo pida, y un archivo de secretos dentro del árbol
# viaja en cada copia de la carpeta aunque Git lo ignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# OBLIGATORIAS — sin ellas Compose aborta antes de crear ningún contenedor
# ------------------------------------------------------------------------------

# Clave de firma de los tokens de sesión. Genérela con:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# Nunca reutilice una clave que haya estado en el repositorio: el backend mantiene una
# lista de claves comprometidas y se niega a arrancar con ellas.
SECRET_KEY=

# Contraseña de PostgreSQL. Mínimo 16 caracteres aleatorios.
#
# CUIDADO: el motor solo aplica este valor al inicializar un directorio de datos VACÍO.
# Si el volumen `pgdata` ya existe, cambiarlo aquí no surte efecto y el backend fallará
# con `password authentication failed`. Para rotarla sobre una pila ya desplegada:
#     python devops/pila.py exec postgres psql -U plurione -c "ALTER USER plurione PASSWORD '<nueva>'"
# y después actualice este archivo.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# Base de datos (opcionales, con valores por defecto razonables)
# ------------------------------------------------------------------------------
POSTGRES_USER=plurione
POSTGRES_DB=lead_scoring_db

# ------------------------------------------------------------------------------
# Sesiones
# ------------------------------------------------------------------------------
# La pila se publica en http://localhost:3000 sin TLS, y el navegador descarta las cookies
# `Secure` sobre HTTP: el refresco de sesión no funcionaría. PÓNGALA EN true en cuanto
# sirva el despliegue detrás de HTTPS.
REFRESH_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Orígenes autorizados para peticiones desde otro dominio (CORS)
# ------------------------------------------------------------------------------
# Déjelo vacío mientras el frontend lo sirva el nginx de esta misma pila: ahí el navegador
# habla con el mismo origen y CORS no interviene.
#
# Rellénelo SOLO si despliega el frontend en otro dominio, y con los orígenes exactos en
# formato de lista JSON:
#     CORS_ORIGINS=["https://app.plurione.com"]
#
# El comodín "*" no se admite: junto a la cookie de sesión, autoriza a cualquier sitio web
# a leer respuestas autenticadas desde el navegador de un usuario con la sesión abierta.
# El backend aborta el arranque si lo encuentra.
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Integración CRM
# ------------------------------------------------------------------------------
# Secreto compartido con el CRM para firmar los webhooks (HMAC-SHA256). Sin él, el
# endpoint queda deshabilitado (503) en lugar de quedar abierto a cualquiera.
CRM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Integridad del artefacto de Machine Learning
# ------------------------------------------------------------------------------
# Huella SHA-256 esperada del .joblib. `joblib` deserializa con pickle, que ejecuta código
# al cargar; con la huella fijada, un artefacto sustituido no llega a deserializarse.
# La imprime `train_model.py` al terminar y queda en ml_pipeline/models/metrics.json.
ML_MODEL_SHA256=

# ------------------------------------------------------------------------------
# Limitación de tasa
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_WEBHOOK=120/minute
# Dónde se lleva la cuenta. La pila de compose levanta un Redis propio y apunta aquí, de
# modo que el tope es exacto y común a todos los workers. Con `memory://` cada worker
# cuenta por su lado y el tope real que ve un cliente es el declarado MULTIPLICADO por el
# número de workers (medido: con 2 workers y "10/minute" pasaban 11-20 intentos de login).
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Si se hace caso a `X-Forwarded-For` para identificar al cliente. Actívelo SOLO si todo
# el tráfico entra por un proxy de confianza que reescriba esa cabecera —el nginx de esta
# pila lo hace—. Expuesto directamente, la cabecera la escribe el cliente y basta con
# rotarla en cada intento para que el tope por IP no llegue a aplicarse nunca.
TRUST_PROXY_HEADERS=true

# ------------------------------------------------------------------------------
# Sesiones e ingesta
# ------------------------------------------------------------------------------
# Margen durante el que un token de refresco recién consumido se sigue admitiendo. Dos
# pestañas del mismo navegador refrescan a la vez y la segunda llegaría con un token que
# la primera acaba de gastar; sin este margen, ese usuario perdería la sesión sin motivo.
REFRESH_ROTATION_GRACE_SECONDS=10

# Ventana durante la que un mismo evento de CRM se considera repetido. La firma HMAC
# autentica el cuerpo pero no acredita que la petición sea nueva: reenviar una entrega
# capturada la volvía a ingerir entera.
CRM_IDEMPOTENCY_WINDOW_SECONDS=900

# ------------------------------------------------------------------------------
# Bitácora de auditoría
# ------------------------------------------------------------------------------
# La aplicación NO borra asientos y no hay ajuste que lo cambie: una bitácora que el
# sistema puede reescribir no prueba nada, porque lo primero que borraría quien abusa de
# sus permisos es el registro de que lo hizo. La retención se aplica desde fuera, con las
# herramientas de la base de datos.
# Tope de asientos por consulta, por encima de lo que pida el cliente.
AUDIT_LOG_MAX_PAGE_SIZE=200

# ------------------------------------------------------------------------------
# Observabilidad (N-14)
# ------------------------------------------------------------------------------
# `json`, `text` o `auto`. Con `auto` manda el entorno: JSON en producción y staging,
# donde los registros los lee una herramienta; texto en desarrollo, donde los lee una
# persona. Un valor mal escrito NO cae en silencio a texto: el arranque aborta.
LOG_FORMAT=json

# Ruta /metrics en formato de exposición de Prometheus.
METRICS_ENABLED=true
# Testigo del recolector. Prometheus no sabe iniciar sesión, así que esta ruta no puede
# depender del JWT del resto de la API.
#
# VACÍO EN PRODUCCIÓN SIGNIFICA APAGADA (404), no abierta. El volcado dice cuántos
# prospectos hay y cómo se reparten por categoría: publicarlo debe ser una decisión.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# ------------------------------------------------------------------------------
# Techos de recursos de los contenedores (N-12)
# ------------------------------------------------------------------------------
# Sin techo, un recálculo desbocado consume la memoria del anfitrión y se lleva por
# delante también a la base de datos. Con techo, el que se pasa muere él solo.
#
# CUIDADO al bajarlos: un techo demasiado justo no produce un error legible, produce un
# proceso que el núcleo mata con código de salida 137 y sin un renglón en el registro.
LIMITE_CPU_BACKEND=2.0
LIMITE_MEM_BACKEND=2g
LIMITE_CPU_POSTGRES=1.0
LIMITE_MEM_POSTGRES=1g
LIMITE_CPU_REDIS=0.5
# Debe ser MAYOR que el `--maxmemory 128mb` con el que arranca Redis: si no, el núcleo
# mata el proceso antes de que la política `allkeys-lru` llegue a desalojar nada.
LIMITE_MEM_REDIS=256m
LIMITE_CPU_FRONTEND=0.5
LIMITE_MEM_FRONTEND=128m
LIMITE_CPU_MIGRATE=1.0
LIMITE_MEM_MIGRATE=512m

# ------------------------------------------------------------------------------
# Copias de seguridad (N-13)
# ------------------------------------------------------------------------------
# Días que se conserva cada volcado en el volumen `pgrespaldos`.
#     python devops/pila.py --profile respaldo run --rm respaldo
#     python devops/pila.py --profile respaldo run --rm prueba-de-restauracion
RETENCION_DIAS=14

# ------------------------------------------------------------------------------
# Plazos de conservación (capítulo 22)
# ------------------------------------------------------------------------------
# Los aplica cada día el servicio `retencion-historial`, junto con el resumen del historial
# de puntuación, y cada pasada deja un asiento por plazo en la bitácora. Por debajo del
# mínimo, el servicio no arranca: un 0 escrito por error no puede vaciar una tabla.
#
# Meses completos de detalle del historial de puntuación, además del mes en curso. Mínimo 3.
SCORE_HISTORY_RETENTION_MONTHS=12
# Días después de CADUCAR una sesión (no de emitirse). Mínimo 7.
CONSERVACION_SESIONES_DIAS=30
# Días desde que TERMINÓ un recálculo masivo; los que siguen vivos no se tocan. Mínimo 7.
CONSERVACION_TRABAJOS_DIAS=90
# Días desde cada sincronización con el CRM. Mínimo 30.
CONSERVACION_REGISTROS_CRM_DIAS=90
# Días desde que un aviso llegó a la bandeja «Sin asociar» sin que nadie lo vinculara. Mínimo 30.
CONSERVACION_SIN_ASOCIAR_DIAS=90

# Solo para la restauración real, que es destructiva. Se pasan en la línea de órdenes y no
# se dejan escritos aquí a propósito: un `CONFIRMO_SOBRESCRIBIR=si` olvidado en un archivo
# convierte la guarda en un adorno.
#   python devops/pila.py --profile respaldo run --rm \
#       -e VOLCADO=/respaldos/lead_scoring_db_20260909T031500Z.dump \
#       -e CONFIRMO_SOBRESCRIBIR=si restaurar

# ------------------------------------------------------------------------------
# Adaptadores de IA (solo con AI_MODE=azure; por defecto se usa el motor local)
# ------------------------------------------------------------------------------
AI_MODE=native
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_ML_ENDPOINT=
AZURE_ML_API_KEY=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=plurione-leads-index

# ==============================================================================
# Herramientas de desarrollo (docker-compose.dev.yml)
# ------------------------------------------------------------------------------
# Solo se leen al invocar el overlay de desarrollo, que añade pgAdmin y publica el puerto
# de PostgreSQL en 127.0.0.1. NO forman parte de la pila de producción:
#     python devops/pila.py --dev up -d
# ==============================================================================
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
# Puerto local al que el overlay expone PostgreSQL (siempre atado a 127.0.0.1).
POSTGRES_PORT=5432
